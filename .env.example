# IMTA AI Institute — environment variables (names only; never commit values).
# Copy to .env.local for development. Set the same names in your host for production.

# Public site URL used for canonical links and the sitemap (e.g. the production domain).
NEXT_PUBLIC_SITE_URL=

# Supabase project URL and publishable (anon) key — safe for the browser; access is limited by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY — Supabase secret (service-role) key. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# SERVER ONLY — random string (32+ chars) used to hash IPs/emails for rate limiting.
RATE_LIMIT_SALT=

# LOCAL ONLY — Postgres connection string (Supabase → Connect → Session pooler), used
# only to apply supabase/migrations. Do NOT set this on the hosting provider.
SUPABASE_DB_URL=
